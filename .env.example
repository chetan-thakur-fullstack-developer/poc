# ==============================================================================
# EXECUTIVE WEALTH · ENVIRONMENT & SUPABASE CONFIGURATION
# ==============================================================================
# IMPORTANT:
# This file stores your Supabase project connection details and backend API keys.
# Keep this file secure and NEVER commit real keys to a public GitHub repository.
#
# Where to find your Supabase credentials:
# 1. Log in to your Supabase dashboard: https://supabase.com/dashboard
# 2. Select your project (or create a new project)
# 3. Go to Project Settings -> API (in the left navigation)
# 4. Copy the "Project URL" -> SUPABASE_URL
# 5. Copy the "Project API keys" -> "anon public" -> SUPABASE_ANON_KEY
# 6. Copy the "Project API keys" -> "service_role secret" -> SUPABASE_SERVICE_ROLE_KEY
# ==============================================================================

# --- Node.js API Server Configuration ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Supabase Account & Database Connection (Backend Node.js API) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# --- Frontend React / Vite Environment Variables (prefixed with VITE_) ---
# These are exposed to the browser client during build / runtime
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
VITE_API_URL=http://localhost:5000/api
